{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neptunus",
  "version": "0.3.6",
  "identifier": "id.neptunus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neptunus",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 26 },
    "iOS": { "frameworks": ["MediaPlayer"] },
    "linux": {
      "deb": { "depends": ["gstreamer1.0-plugins-good", "gstreamer1.0-plugins-bad", "gstreamer1.0-libav"], "recommends": ["mpv", "ffmpeg"] },
      "rpm": { "depends": ["gstreamer1-plugins-good", "gstreamer1-plugins-bad-free", "gstreamer1-libav"], "recommends": ["mpv", "ffmpeg"] }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}