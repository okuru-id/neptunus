{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neptunus",
  "version": "0.2.21",
  "identifier": "id.neptunus.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neptunus",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": { "minSdkVersion": 26 },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}